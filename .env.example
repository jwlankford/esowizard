# Copy to .env (never commit .env). Backend-only: none of these reach the Vue app.

# Neon pooled connection string (host contains "-pooler"). Plain postgresql:// also works.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Neon direct (non-pooled) connection string, used by Alembic and admin tasks. Optional.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=require

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Vector width. Must match the migration and all stored embeddings; changing it needs re-embedding.
EMBEDDING_DIMENSIONS=768

# Chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# RAG. RETRIEVAL_MIN_SCORE is a development default (cosine similarity) that needs tuning.
RAG_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5

LOG_LEVEL=INFO
